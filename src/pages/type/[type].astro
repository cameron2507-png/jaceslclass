---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import TypeIcon from '../../components/TypeIcon.astro';
import { TYPE_NAMES, typeSlug, typeBlurb, typeLabel, gameLevels, countBy, byNewest } from '../../data/taxonomy';

export async function getStaticPaths() {
  const all = await getCollection('games');
  const counts = countBy(all, g => [g.data.type]);
  const used = TYPE_NAMES.filter(t => counts.get(t));
  // Only build pages for types that have games.
  return used.map(type => ({
    params: { type: typeSlug(type) },
    props: {
      type,
      games: all.filter(g => g.data.type === type).sort(byNewest),
      others: used.filter(t => t !== type),
    },
  }));
}

const { type, games, others } = Astro.props;
const blurb = typeBlurb(type);
---
<BaseLayout
  title={`${typeLabel(type)} for ESL — JAC's Class`}
  description={`Free ${typeLabel(type)} for English teachers. ${blurb}`}
>
  <section class="section">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> › <a href="/types">Game types</a> › {type}
      </nav>
      <h1 class="page-title-with-icon"><TypeIcon type={type} size={34} />{typeLabel(type)}</h1>
      <p class="page-lede">{blurb} {games.length} {games.length === 1 ? 'game' : 'games'}.</p>

      <div class="games-grid">
        {games.map(game => (
          <GameCard slug={game.id} title={game.data.title} level={game.data.level} levels={gameLevels(game)}
            type={game.data.type} topic={game.data.topic} duration={game.data.duration} />
        ))}
      </div>

      {others.length > 0 && (
        <div class="browse-more">
          <p>Other game types:</p>
          <div class="type-row">
            {others.map(t => (
              <a href={`/type/${typeSlug(t)}`} class="pill pill--type"><TypeIcon type={t} size={16} />{t}</a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
