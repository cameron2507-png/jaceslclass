---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import { LEVELS, levelLabel, gameLevels, countBy, byNewest } from '../../data/taxonomy';

export async function getStaticPaths() {
  const all = await getCollection('games');
  const counts = countBy(all, g => gameLevels(g));
  // Only build pages for levels that have games.
  return LEVELS.filter(l => counts.get(l.code)).map(l => ({
    params: { level: l.code },
    props: {
      level: l.code,
      games: all.filter(g => gameLevels(g).includes(l.code)).sort(byNewest),
      others: LEVELS.filter(o => o.code !== l.code && counts.get(o.code)),
    },
  }));
}

const { level, games, others } = Astro.props;
const label = levelLabel(level);
---
<BaseLayout
  title={`${level} (${label}) ESL games — JAC's Class`}
  description={`${games.length} free interactive ESL games for ${level} ${label} learners: Jeopardy, Typhoon, Taboo and more, ready to project in class.`}
>
  <section class="section">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> › <a href="/levels">Levels</a> › {level}
      </nav>
      <h1 class="page-title-with-pill">
        <span class={`pill pill--level pill--lg level-${level}`}>{level}</span>
        {label} games
      </h1>
      <p class="page-lede">
        {games.length} {games.length === 1 ? 'game' : 'games'} for {level} learners, including games that span {level} and a neighbouring level.
      </p>

      <div class="games-grid">
        {games.map(game => (
          <GameCard slug={game.id} title={game.data.title} level={game.data.level} levels={gameLevels(game)}
            type={game.data.type} topic={game.data.topic} duration={game.data.duration} />
        ))}
      </div>

      {others.length > 0 && (
        <div class="browse-more">
          <p>Other levels:</p>
          <div class="type-row">
            {others.map(l => (
              <a href={`/level/${l.code}`} class={`pill pill--level level-${l.code}`}>{l.code} {l.label}</a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
