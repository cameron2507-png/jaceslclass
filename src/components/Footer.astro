---
import { getCollection } from 'astro:content';
import { LEVELS, TYPE_NAMES, typeSlug, gameLevels, countBy } from '../data/taxonomy';

const year = new Date().getFullYear();
const games = await getCollection('games');
const levelCounts = countBy(games, g => gameLevels(g));
const typeCounts = countBy(games, g => [g.data.type]);
const levels = LEVELS.filter(l => levelCounts.get(l.code));
const types = TYPE_NAMES.filter(t => typeCounts.get(t)).sort((a, b) => typeCounts.get(b)! - typeCounts.get(a)!);
---
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__about">
      <a href="/" class="brand">
        <span class="brand__mark">JAC</span>
        <span class="brand__name">JAC's Class</span>
      </a>
      <p>Free interactive games for English teachers. No login, no prep: open a game and put it on the projector.</p>
    </div>
    <nav aria-label="Games by level">
      <h2>Levels</h2>
      <ul>
        {levels.map(l => <li><a href={`/level/${l.code}`}>{l.code} {l.label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Games by type">
      <h2>Game types</h2>
      <ul class="site-footer__cols">
        {types.map(t => <li><a href={`/type/${typeSlug(t)}`}>{t}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Site">
      <h2>Site</h2>
      <ul>
        <li><a href="/games">All games</a></li>
        <li><a href="/listening">Listening</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="mailto:hello@jaceslclass.com">Contact</a></li>
      </ul>
    </nav>
  </div>
  <div class="container site-footer__base">© {year} JAC's Class. Free ESL games for the classroom.</div>
</footer>
