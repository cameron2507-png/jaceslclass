---
import TypeIcon from './TypeIcon.astro';
import { levelRange } from '../data/taxonomy';

interface Props {
  slug: string;
  title: string;
  level: 'A1' | 'A2' | 'B1' | 'B2' | 'C1';
  levels?: string[];
  type: string;
  topic: string;
  duration: number;
}

const { slug, title, level, levels = [level], type, topic, duration } = Astro.props;
---
<a href={`/games/${slug}`} class="game-card">
  <div class="game-card__top">
    <span class="game-card__type"><TypeIcon type={type} size={18} />{type}</span>
    <span class={`pill pill--level level-${level}`}>{levelRange(levels)}</span>
  </div>
  <h3 class="game-card__title">{title}</h3>
  <p class="game-card__meta">
    <span>{topic}</span>
    <span>{duration} min</span>
  </p>
</a>
